{
  "$schema": "https://operator.local/schemas/operator-capability.v1.json",
  "apiVersion": "operator.dev/v1",
  "kind": "workflow",
  "id": "research.paper-from-results",
  "displayName": "Research Paper from Results",
  "description": "Bundled Mastra workflow that turns structured research results into paper draft artifacts.",
  "source": {
    "type": "bundled",
    "provider": "local",
    "root": "apps/mastra/src/workflows/research/paper-from-results"
  },
  "adapter": {
    "type": "mastra-workflow",
    "entrypoints": {
      "workflow": "workflow.ts",
      "schemas": "schemas.ts",
      "tools": "tools.ts",
      "nativePaper": "native-paper.ts"
    }
  },
  "configuration": {
    "requiredEnv": [],
    "optionalEnv": [],
    "providers": []
  },
  "validation": {
    "requiredPaths": [
      "workflow.ts",
      "schemas.ts",
      "tools.ts",
      "native-paper.ts"
    ],
    "capabilityTests": [
      {
        "name": "workflow-contract-entrypoints-present",
        "type": "golden-example",
        "source": "operator-golden-example",
        "command": "test -s {capability_root}/workflow.ts && test -s {capability_root}/schemas.ts && test -s {capability_root}/tools.ts && test -s {capability_root}/native-paper.ts",
        "required": true,
        "timeoutMs": 10000
      }
    ]
  },
  "exposure": {
    "scopes": [
      {
        "id": "research.paper-from-results",
        "surface": "chat",
        "enabledByDefault": true
      }
    ],
    "artifacts": [
      {
        "type": "research_paper",
        "formats": ["md", "docx", "pdf"]
      }
    ]
  }
}
