    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.21.1",
    "@mastra/acp": "0.2.1",
    "@mastra/core": "1.41.0",
    "@opentelemetry/api": "^1.9.1",
    "@operator/contracts": "workspace:*",
    "@operator/core": "workspace:*",
    "cheerio": "1.1.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
