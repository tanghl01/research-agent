{
  "name": "@operator/mastra-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/mastra.ts",
    "./chat": "./src/chat.ts",
    "./product-scopes": "./src/product-scopes/catalog.ts"
  },
  "bin": {
    "operator": "./src/cli.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
