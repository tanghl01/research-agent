{
  "$schema": "https://operator.local/schemas/skill-manifest.v1.json",
  "id": "GordenPPTSkill",
  "kind": "agent_skill",
  "display_name": "GordenPPTSkill",
  "description": "Editable PowerPoint generation skill with 19 built-in PPT templates and build_pptx.py renderer.",
  "source": {
    "type": "git",
    "repo": "https://github.com/GordenSun/GordenPPTSkill.git",
    "ref": "main",
    "commit": "efb016b683d2e664242de010c9562c1c2e6953a4"
  },
  "cache": {
    "development_root": "skills/vendored/GordenPPTSkill",
    "production_root_env": "OPERATOR_SKILL_CACHE_ROOT",
    "production_path_template": "{root}/{id}/{commit}"
  },
  "env": {
    "root_override": "OPERATOR_GORDEN_PPT_SKILL_ROOT"
  },
  "entrypoints": {
    "skill": "SKILL.md",
    "template_index": "templates/INDEX.md",
    "templates": "templates",
    "build_pptx": "scripts/build_pptx.py"
  },
  "runtime": {
    "type": "python_venv",
    "cache_env": "OPERATOR_RUNTIME_CACHE_ROOT",
    "cache_key_files": [
      "scripts/build_pptx.py"
    ],
    "setup": {
      "cwd": ".",
      "complete_marker": ".operator-runtime-ready",
      "commands": [
        "mkdir -p {runtime_root}",
        "test -x {python} || {system_python} -m venv {venv}",
        "{pip} install --upgrade pip",
        "{pip} install python-pptx",
        "touch {setup_complete_path}"
      ]
    },
    "commands": {
      "python": "{python}",
      "pip": "{pip}",
      "build_pptx": "{python} {skill_root}/scripts/build_pptx.py"
    },
    "notes": [
      "Use the cached runtime command build_pptx instead of relying on system Python packages.",
      "Generated PPTX files belong in the task workspace."
    ]
  },
  "install": {
    "smoke_tests": [
      {
        "name": "build_pptx_help",
        "command": "{python} {skill_root}/scripts/build_pptx.py --help",
        "timeout_ms": 30000
      }
    ],
    "capability_tests": [
      {
        "name": "build_pptx_cli_available",
        "type": "golden-example",
        "source": "operator-golden-example",
        "command": "{python} {skill_root}/scripts/build_pptx.py --help",
        "timeout_ms": 30000
      }
    ]
  },
  "required_paths": [
    "SKILL.md",
    "templates/INDEX.md",
    "scripts/build_pptx.py"
  ],
  "license": {
    "notice": "Built-in templates are marked by the source skill as non-commercial."
  }
}
