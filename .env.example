# Operator uses Mastra as the framework. The default chat entry runs through the
# main execution agent selected here. External execution agents are ACP runtimes.
OPERATOR_DEPLOYMENT_STAGE=development
OPERATOR_DEFAULT_AGENT_SCOPE=codex-acp
OPERATOR_AGENT_FALLBACK_ORDER=codex-acp,codex-acp-packycode,claude-code-acp-packycode,claude-code-acp,openhands-acp

# Self-hosted Operator backend. DATABASE_URL points to PostgreSQL.
OPERATOR_BACKEND_ENABLED=true
DATABASE_URL=postgres://operator:operator@127.0.0.1:5432/operator
# Operator guest/dev sessions still use a local signed cookie. Production accounts
# should come from OIDC below.
OPERATOR_SESSION_SECRET=replace-with-at-least-24-random-characters
OPERATOR_OIDC_ISSUER=
OPERATOR_OIDC_AUDIENCE=
OPERATOR_OIDC_JWKS_URI=
OPERATOR_OIDC_COOKIE_NAME=operator_identity_token
# Temporary email-only login is for trusted development deployments only.
# Production should wire a verified identity provider before enabling email login.
OPERATOR_ALLOW_UNVERIFIED_EMAIL_LOGIN=false
# Phone login uses one-time SMS codes.
OPERATOR_PHONE_LOGIN_PROVIDER=aliyun-dypns
OPERATOR_PHONE_LOGIN_CODE_TTL_SECONDS=600
OPERATOR_PHONE_LOGIN_DEBUG_CODE=true
OPERATOR_SMS_WEBHOOK_URL=
OPERATOR_SMS_WEBHOOK_TOKEN=
# Aliyun Phone Number Verification Service SMS authentication uses the official
# gifted signature/template by default: SignName=速通互联验证码, TemplateCode=100001.
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
OPERATOR_ALIYUN_REGION_ID=cn-hangzhou
OPERATOR_ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
OPERATOR_ALIYUN_DYPNS_TEMPLATE_PARAM='{"code":"##code##","min":"10"}'
OPERATOR_ALIYUN_DYPNS_CODE_LENGTH=6
OPERATOR_ALIYUN_DYPNS_INTERVAL_SECONDS=60
OPERATOR_ALIYUN_DYPNS_RETURN_VERIFY_CODE=false
# Local storage is allowed for development and single-host internal beta.
# Formal production should set OPERATOR_DEPLOYMENT_STAGE=production and
# OPERATOR_STORAGE_PROVIDER=s3.
OPERATOR_STORAGE_PROVIDER=local
OPERATOR_STORAGE_ROOT=tmp/object-storage
OPERATOR_STORAGE_ARTIFACT_BUCKET=operator-artifacts
OPERATOR_STORAGE_DRIVE_BUCKET=operator-drive
OPERATOR_STORAGE_CACHE_BUCKET=operator-cache
# S3-compatible storage: AWS S3, R2, MinIO, or equivalent. Access keys are
# optional when the runtime has an IAM/default credential chain.
OPERATOR_S3_ENDPOINT=
OPERATOR_S3_REGION=
OPERATOR_S3_ACCESS_KEY_ID=
OPERATOR_S3_SECRET_ACCESS_KEY=
OPERATOR_S3_FORCE_PATH_STYLE=
# Redis powers BullMQ queues and production rate limiting.
REDIS_URL=

OPERATOR_AGNES_API_KEY=
OPERATOR_DEEPSEEK_API_KEY=
OPERATOR_PACKY_API_KEY=
OPERATOR_PACKY_BASE_URL=https://www.packyapi.com/v1
OPERATOR_PACKY_MODEL=gpt-5.5
OPERATOR_PACKY_ANTHROPIC_BASE_URL=https://www.packyapi.com
OPERATOR_PACKY_CLAUDE_MODEL=claude-opus-4-8
OPERATOR_PACKY_IMAGE_API_KEY=
OPERATOR_PACKY_IMAGE_BASE_URL=https://www.packyapi.com/v1
OPERATOR_PACKY_IMAGE_MODEL=gpt-image-2
OPERATOR_PACKY_IMAGE_QUALITY=low

# External ACP-compatible agents registered as main/fallback execution runtimes.
# Prefer this JSON form for multiple runtimes:
# OPERATOR_MASTRA_ACP_AGENTS_JSON=[{"id":"codex-acp","name":"Codex ACP","description":"Codex through ACP","command":"npx","args":["@agentclientprotocol/codex-acp"],"persistSession":false}]
OPERATOR_MASTRA_ACP_AGENTS_JSON=
OPERATOR_ACP_AGENTS_JSON=

# Convenience single-agent ACP configs. These only register when *_COMMAND is set.
OPERATOR_CODEX_ACP_COMMAND=
OPERATOR_CODEX_ACP_ARGS=
OPERATOR_CODEX_ACP_MODEL=
OPERATOR_CODEX_ACP_CWD=
OPERATOR_CODEX_ACP_ENV=
OPERATOR_CODEX_ACP_PERSIST_SESSION=false

# Codex ACP through PackyCode. Point CODEX_HOME at a Codex config whose
# model_provider uses OPERATOR_PACKY_BASE_URL and the Responses API.
OPERATOR_CODEX_ACP_PACKYCODE_COMMAND=
OPERATOR_CODEX_ACP_PACKYCODE_ARGS=
OPERATOR_CODEX_ACP_PACKYCODE_MODEL=
OPERATOR_CODEX_ACP_PACKYCODE_CWD='${OPERATOR_REPO_ROOT}'
OPERATOR_CODEX_ACP_PACKYCODE_ENV='{"CODEX_HOME":"${OPERATOR_REPO_ROOT}/.local/codex-acp-packycode-home","OPENAI_API_KEY":"$OPERATOR_PACKY_API_KEY","OPENAI_BASE_URL":"$OPERATOR_PACKY_BASE_URL"}'
OPERATOR_CODEX_ACP_PACKYCODE_PERSIST_SESSION=false

# Claude Code ACP through PackyCode's Anthropic-compatible endpoint.
OPERATOR_CLAUDE_CODE_ACP_PACKYCODE_COMMAND=
OPERATOR_CLAUDE_CODE_ACP_PACKYCODE_ARGS='-y @agentclientprotocol/claude-agent-acp'
OPERATOR_CLAUDE_CODE_ACP_PACKYCODE_MODEL=
OPERATOR_CLAUDE_CODE_ACP_PACKYCODE_CWD='${OPERATOR_REPO_ROOT}'
OPERATOR_CLAUDE_CODE_ACP_PACKYCODE_ENV='{"HOME":"${OPERATOR_REPO_ROOT}/.local/claude-code-acp-packycode-home","CLAUDE_CONFIG_DIR":"${OPERATOR_REPO_ROOT}/.local/claude-code-acp-packycode-home/.claude","CLAUDE_CODE_EXECUTABLE":"claude","ANTHROPIC_BASE_URL":"$OPERATOR_PACKY_ANTHROPIC_BASE_URL","ANTHROPIC_AUTH_TOKEN":"$OPERATOR_PACKY_API_KEY","ANTHROPIC_API_KEY":"$OPERATOR_PACKY_API_KEY","ANTHROPIC_MODEL":"$OPERATOR_PACKY_CLAUDE_MODEL","ANTHROPIC_DEFAULT_SONNET_MODEL":"$OPERATOR_PACKY_CLAUDE_MODEL","ANTHROPIC_DEFAULT_HAIKU_MODEL":"$OPERATOR_PACKY_CLAUDE_MODEL","ANTHROPIC_DEFAULT_OPUS_MODEL":"$OPERATOR_PACKY_CLAUDE_MODEL","CLAUDE_CODE_SUBAGENT_MODEL":"$OPERATOR_PACKY_CLAUDE_MODEL","API_TIMEOUT_MS":"1200000","CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC":"1","DISABLE_TELEMETRY":"1"}'
OPERATOR_CLAUDE_CODE_ACP_PACKYCODE_PERSIST_SESSION=false

# Claude Code ACP through Agnes.
OPERATOR_CLAUDE_CODE_ACP_COMMAND=npx
OPERATOR_CLAUDE_CODE_ACP_ARGS='-y @agentclientprotocol/claude-agent-acp'
OPERATOR_CLAUDE_CODE_ACP_NAME=Claude Code ACP (Agnes)
OPERATOR_CLAUDE_CODE_ACP_MODEL=agnes-2.0-flash
OPERATOR_CLAUDE_CODE_ACP_CWD=
OPERATOR_CLAUDE_CODE_ACP_ENV='{"HOME":"${OPERATOR_REPO_ROOT}/.local/claude-code-acp-agnes-home","CLAUDE_CONFIG_DIR":"${OPERATOR_REPO_ROOT}/.local/claude-code-acp-agnes-home/.claude","CLAUDE_CODE_EXECUTABLE":"claude","ANTHROPIC_BASE_URL":"http://127.0.0.1:4011","ANTHROPIC_API_KEY":"dummy","ANTHROPIC_MODEL":"agnes-2.0-flash","ANTHROPIC_DEFAULT_SONNET_MODEL":"agnes-2.0-flash","ANTHROPIC_DEFAULT_HAIKU_MODEL":"agnes-2.0-flash","ANTHROPIC_DEFAULT_OPUS_MODEL":"agnes-2.0-flash","CLAUDE_CODE_SUBAGENT_MODEL":"agnes-2.0-flash","API_TIMEOUT_MS":"1200000","CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC":"1","DISABLE_TELEMETRY":"1"}'
OPERATOR_CLAUDE_CODE_ACP_PERSIST_SESSION=false

# Claude Code ACP via DeepSeek uses DeepSeek's Anthropic-compatible API directly.
# Set OPERATOR_DEEPSEEK_API_KEY and this command to opt into the fallback.
OPERATOR_CLAUDE_CODE_DEEPSEEK_ACP_COMMAND=
OPERATOR_CLAUDE_CODE_DEEPSEEK_ACP_ARGS='["-y","@agentclientprotocol/claude-agent-acp"]'
OPERATOR_CLAUDE_CODE_DEEPSEEK_ACP_MODEL=
OPERATOR_CLAUDE_CODE_DEEPSEEK_ACP_CWD='${OPERATOR_REPO_ROOT}'
OPERATOR_CLAUDE_CODE_DEEPSEEK_ACP_ENV='{"HOME":"${OPERATOR_REPO_ROOT}/.local/claude-code-acp-deepseek-home","CLAUDE_CONFIG_DIR":"${OPERATOR_REPO_ROOT}/.local/claude-code-acp-deepseek-home/.claude","CLAUDE_CODE_EXECUTABLE":"claude","ANTHROPIC_BASE_URL":"https://api.deepseek.com/anthropic","ANTHROPIC_AUTH_TOKEN":"$OPERATOR_DEEPSEEK_API_KEY","ANTHROPIC_API_KEY":"dummy","ANTHROPIC_MODEL":"deepseek-v4-flash","ANTHROPIC_DEFAULT_SONNET_MODEL":"deepseek-v4-flash","ANTHROPIC_DEFAULT_HAIKU_MODEL":"deepseek-v4-flash","ANTHROPIC_DEFAULT_OPUS_MODEL":"deepseek-v4-flash","CLAUDE_CODE_SUBAGENT_MODEL":"deepseek-v4-flash","API_TIMEOUT_MS":"1200000","CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC":"1","DISABLE_TELEMETRY":"1"}'
OPERATOR_CLAUDE_CODE_DEEPSEEK_ACP_PERSIST_SESSION=false

# Register OpenHands only when it exposes an ACP-compatible runtime command.
OPERATOR_OPENHANDS_ACP_COMMAND=
OPERATOR_OPENHANDS_ACP_ARGS=
OPERATOR_OPENHANDS_ACP_NAME=OpenHands ACP (Agnes)
OPERATOR_OPENHANDS_ACP_MODEL=agnes-2.0-flash
OPERATOR_OPENHANDS_ACP_CWD=
OPERATOR_OPENHANDS_ACP_ENV='{"OPENAI_BASE_URL":"https://apihub.agnes-ai.com/v1","OPENAI_API_KEY":"$OPERATOR_AGNES_API_KEY","OPENHANDS_MODEL":"agnes-2.0-flash","LLM_MODEL":"agnes-2.0-flash"}'
OPERATOR_OPENHANDS_ACP_PERSIST_SESSION=false

# Shared ACP main-agent timeout.
OPERATOR_MASTRA_AGENT_TIMEOUT_SECONDS=2400

# Optional Mastra web/search tools. These are registered in the Mastra app.
OPERATOR_BRAVE_SEARCH_API_KEY=
OPERATOR_TAVILY_API_KEY=
OPERATOR_SERPER_API_KEY=
OPERATOR_BING_SEARCH_API_KEY=
OPERATOR_WEB_FETCH_TIMEOUT_SECONDS=30
OPERATOR_WEB_DOWNLOAD_MAX_BYTES=104857600
OPERATOR_WEB_USER_AGENT=

# Reusable runtime cache for skill dependencies. Relative paths resolve from the
# monorepo root. Task workspaces should contain inputs and artifacts, not large
# per-run dependency environments.
OPERATOR_RUNTIME_CACHE_ROOT=tmp/runtimes
# Shared pip download/build cache used by all skill venv installations. Defaults
# to OPERATOR_RUNTIME_CACHE_ROOT/_pip-cache when unset.
OPERATOR_PIP_CACHE_DIR=
# Successful/failed capability lifecycle receipts for skills, workflows, agents,
# tools, and packages. Defaults to OPERATOR_RUNTIME_CACHE_ROOT/_capability-installs.
OPERATOR_CAPABILITY_INSTALL_STATE_ROOT=

# Skill roots exposed as Mastra Workspace Skills through skills/manifests and
# apps/mastra/src/skills/operator-skill-source.ts.
OPERATOR_GORDEN_PPT_SKILL_ROOT=
OPERATOR_GUIZANG_PPT_SKILL_ROOT=
OPERATOR_PPT_MASTER_SKILL_ROOT=
OPERATOR_SCIENTIFIC_AGENT_SKILLS_ROOT=
OPERATOR_TEXT_TO_CAD_ROOT=
OPERATOR_CLAUDE_FOR_LEGAL_ROOT=
OPERATOR_BIOMNI_ROOT=
